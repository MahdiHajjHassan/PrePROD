generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  MEMBER
  ADMIN
}

enum TaskStatus {
  OPEN
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum DomainAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
}
enum DomainEntity {
  TASK
  USER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  displayName  String
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())
  sessions     Session[]
  tasks        Task[]
  activityEvents ActivityEvent[] @relation("ActivityActor")
  notifications Notification[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id          String       @id @default(uuid())
  ownerId     String
  title       String
  description String       @default("")
  status      TaskStatus   @default(OPEN)
  priority    TaskPriority @default(NORMAL)
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt, id])
  @@index([status, priority])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

model ActivityEvent {
  id         String @id @default(uuid())
  actorId    String?
  action     DomainAction
  entityType DomainEntity
  entityId   String
  label      String
  completed  Boolean @default(false)
  createdAt  DateTime @default(now())
  actor      User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  notifications Notification[]
  @@index([actorId, createdAt])
}

model Notification {
  id          String @id @default(uuid())
  recipientId String
  eventId     String
  readAt      DateTime?
  recipient   User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  event       ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([recipientId, eventId])
  @@index([recipientId, readAt])
}
