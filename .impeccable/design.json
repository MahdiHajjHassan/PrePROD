      "description": "Destructive action shown inside confirmation.",
      "html": "<button class=\"ds-button ds-button-danger\" type=\"button\">Resign</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:.65rem;min-height:48px;padding:.7rem 1.25rem;border:1px solid transparent;border-radius:var(--radius,.75rem);font-family:\"Readex Pro\",system-ui,sans-serif;font-weight:500;font-size:.875rem;line-height:1.5;text-align:center;cursor:pointer;transition:transform 180ms var(--ease,cubic-bezier(.16,1,.3,1)),background-color 180ms,border-color 180ms}.ds-button:hover:not(:disabled){transform:translateY(-2px)}.ds-button:active:not(:disabled){transform:translateY(0) scale(.98)}.ds-button:focus-visible{outline:3px solid var(--accent,#294f37);outline-offset:4px}.ds-button:disabled{cursor:wait;opacity:.6}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-button-danger{background:var(--error,#a23330);color:var(--on-error,#fff);border-color:transparent}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "text-field",
      "description": "A labelled native input with linked hint text.",
      "html": "<div class=\"ds-field\"><label for=\"ds-room-code\">Room code</label><input id=\"ds-room-code\" type=\"text\" dir=\"ltr\" placeholder=\"Enter room code\" aria-describedby=\"ds-room-hint\"><small id=\"ds-room-hint\">Ask your friend for the room code.</small></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.45rem;font-family:\"Readex Pro\",system-ui,sans-serif;color:var(--text,#203c2e)}.ds-field label{font-size:.8125rem;font-weight:500}.ds-field input{background:var(--surface,#fffef9);border:1px solid var(--control-border,#718372);border-radius:var(--radius,.75rem);color:var(--text,#203c2e);min-height:48px;padding:.75rem .875rem;font:inherit;transition:border-color 150ms,background-color 150ms}.ds-field input:hover{border-color:var(--accent,#294f37)}.ds-field input:focus-visible{outline:3px solid var(--accent,#294f37);outline-offset:4px}.ds-field input[aria-invalid=\"true\"]{border-color:var(--error,#a23330)}.ds-field input:read-only{background:var(--muted-surface,#e9ecdf)}.ds-field input::placeholder,.ds-field small{color:var(--muted,#56665a)}.ds-field small{font-size:.8125rem}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none}}"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact page links with explicit current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#play\" aria-current=\"page\">Play</a><a href=\"#account\">Account</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;align-items:center;gap:.25rem;font-family:\"Readex Pro\",system-ui,sans-serif}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;color:var(--muted,#56665a);text-decoration:none;padding:.65rem .9rem;border-radius:.6rem;font-size:.8125rem;transition:color 150ms,background-color 150ms}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{background:var(--muted-surface,#e9ecdf);color:var(--text,#203c2e)}.ds-nav a[aria-current=\"page\"]{font-weight:600}.ds-nav a:focus-visible{outline:3px solid var(--accent,#294f37);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav a{display:inline-flex;align-items:center;min-height:44px;transition:none}}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Text status with an accent dot for connection feedback.",
      "html": "<span class=\"ds-badge\">Connected</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:.45rem;padding:.25rem .65rem;border-radius:2rem;background:var(--muted-surface,#e9ecdf);color:var(--accent,#294f37);font-family:\"Readex Pro\",system-ui,sans-serif;font-size:.75rem;font-weight:500;white-space:nowrap}.ds-badge::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Club Play Panel",
      "kind": "card",
      "refersTo": "club-panel",
      "description": "The forest enclosure used for the computer play choice.",
      "html": "<section class=\"ds-club-panel\"><h2>Computer</h2><p>Play a game against the computer.</p></section>",
      "css": ".ds-club-panel{display:flex;flex-direction:column;align-items:start;gap:1rem;min-width:0;padding:2rem;background:var(--club,#234633);color:var(--on-club,#f8f8ed);border-radius:1rem;font-family:\"Readex Pro\",system-ui,sans-serif}.ds-club-panel h2{margin:0;font-size:2rem;line-height:1.35;font-weight:600;letter-spacing:-.025em}.ds-club-panel p{margin:0;color:var(--club-muted,#c1d1bf);max-width:40ch;font-size:.875rem;line-height:1.7}@media(max-width:760px){.ds-club-panel{padding:1.75rem}}@media(max-width:520px){.ds-club-panel{padding:1.5rem}.ds-club-panel h2{font-size:1.75rem}}"
    },
    {
      "name": "Game Cell",
      "kind": "custom",
      "refersTo": "game-cell",
      "description": "A stable native cell button with an authored SVG X mark.",
      "html": "<button class=\"ds-game-cell\" type=\"button\" aria-disabled=\"true\" aria-label=\"Row 1, column 1: X\"><svg class=\"ds-mark\" viewBox=\"0 0 100 100\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"9\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M24 24 76 76\"/><path d=\"M76 24 24 76\"/></svg></button>",
      "css": ".ds-game-cell{aspect-ratio:1;width:140px;min-height:60px;border:1px solid var(--control-border,#718372);border-radius:0;background:var(--surface,#fffef9);display:grid;place-items:center;padding:0;transition:background-color 180ms,box-shadow 180ms}.ds-game-cell[aria-disabled=\"true\"]{opacity:1;cursor:default}.ds-game-cell[aria-disabled=\"false\"]:hover{background:var(--muted-surface,#e9ecdf);box-shadow:inset 0 0 0 2px var(--accent,#294f37)}.ds-game-cell[aria-disabled=\"false\"]:active{background:var(--muted-surface,#e9ecdf)}.ds-game-cell:focus-visible{position:relative;outline:3px solid var(--accent,#294f37);outline-offset:-5px}.ds-mark{width:65%;height:65%;max-height:110px;color:var(--x,#315bca)}@media(prefers-reduced-motion:reduce){.ds-game-cell{transition:none}}"
    },
